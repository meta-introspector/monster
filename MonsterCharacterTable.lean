/-- The rational part `A` of an entry `(A + B*sqrt R)/2`. -/
@[inline] def entryA (e : Entry) : Int := e.1
/-- Complex conjugate of an entry: flip the sign of the `sqrt R` part when `R < 0`
(imaginary quadratic), identity otherwise. -/
def conjE (e : Entry) : Entry :=
  if e.2.2 < 0 then (e.1, -e.2.1, e.2.2) else e
/-- The squarefree radicand `R` used in a row (`0` if the row is rational). -/
def rowRoot (row : List Entry) : Int :=
  (row.filterMap (fun e => if e.2.2 ≠ 0 then some e.2.2 else none)).headI
/-- Precomputed radicands of the 194 rows. -/
def rowRoots : List Int := charTable.map rowRoot
/-- The four integer components `(C0, Cx, Cy, Cxy)` of the weighted sum
`sum_c |class c| * chi_i(c) * conj(chi_k(c))` expressed in the basis
`{1, sqrt Ri, sqrt Rk, sqrt Ri * sqrt Rk}` of the compositum, scaled by `4` to clear
the two denominators of `2`. -/
def comps (rowi rowk : List Entry) : Int × Int × Int × Int :=
  ((rowi.zip rowk).zip classSizes).foldl
    (fun acc p =>
      let ei := p.1.1
      let ek := conjE p.1.2
      let cs := p.2
      (acc.1 + cs * ei.1 * ek.1,
       acc.2.1 + cs * ei.2.1 * ek.1,
       acc.2.2.1 + cs * ei.1 * ek.2.1,
       acc.2.2.2 + cs * ei.2.1 * ek.2.1))
    (0, 0, 0, 0)
/-- The orthogonality check for the ordered pair of rows with radicands `Ri, Rk`
and Kronecker delta `delta`. -/
def pairOK (Ri Rk : Int) (rowi rowk : List Entry) (delta : Int) : Bool :=
  let c := comps rowi rowk
  let C0 := c.1
  let Cx := c.2.1
  let Cy := c.2.2.1
  let Cxy := c.2.2.2
  if Ri == Rk && Ri ≠ 0 then
    -- same quadratic field: sqrt Ri * sqrt Ri = Ri, and the two sqrt Ri coefficients combine
    (Cx + Cy == 0) && (C0 + Cxy * Ri == 4 * monsterOrder * delta)
  else
    -- distinct fields (or a rational row): all irrational components must vanish
    (Cx == 0) && (Cy == 0) && (Cxy == 0) && (C0 == 4 * monsterOrder * delta)
/-- The Boolean asserting the full first orthogonality relation over all `194^2`
pairs of irreducible characters. -/
def orthonormalAll : Bool :=
  let rows := charTable.toArray
  let roots := rowRoots.toArray
  (List.range 194).all (fun i =>
    (List.range 194).all (fun k =>
      pairOK (roots.getD i 0) (roots.getD k 0)
        (rows.getD i []) (rows.getD k []) (if i == k then 1 else 0)))
/-! ## Verification -/
/-- The character table has `194` rows (irreducible characters). -/
theorem charTable_nrows : charTable.length = 194 := by native_decide
/-- The character table has `194` columns (conjugacy classes) in every row. -/
theorem charTable_ncols : ∀ row ∈ charTable, row.length = 194 := by native_decide
/-- There are `194` conjugacy classes. -/
theorem classSizes_length : classSizes.length = 194 := by native_decide
/-- The conjugacy-class sizes sum to the order of the Monster. -/
theorem sum_classSizes : classSizes.sum = monsterOrder := by native_decide
/-- The first column (values on the identity) gives the `194` irreducible degrees,
reproducing `MonsterIrreps.monsterIrrepDims`. -/
theorem charTable_degrees :
    charTable.map (fun row => entryA row.headI / 2)
      = MonsterIrreps.monsterIrrepDims.map (fun n => (n : Int)) := by
  native_decide
/-- **First orthogonality relation for the Monster.**  The `194` irreducible
characters are orthonormal with respect to the class-size-weighted Hermitian inner
product: for all `i, k`,
`sum_c |class c| * chi_i(c) * conj(chi_k(c)) = |M| * delta_ik`.  Discharging this
single Boolean certifies the entire `194 x 194` character table. -/
theorem monster_characters_orthonormal : orthonormalAll = true := by native_decide
end MonsterCharacterTable
